# Django
SECRET_KEY=change-this-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Nairobi
AUTH_TOKEN_TTL_DAYS=14
# What lands in backend/logs/shop.log: INFO is enough to trace a payment the
# next morning; raise to DEBUG only while something is being diagnosed.
LOG_LEVEL=INFO

# Shop branding returned to the app and printed on receipts
SHOP_NAME=Greenlight LED Accessories
SHOP_WEBSITE=greenlightledaccessories.com
SHOP_PHONE=

# Database. Blank means SQLite, which is a supported choice on a hosted server
# too - gunicorn then runs one process with several threads, because two writers
# on one file produce locked databases and half-recorded bills. Set this to a
# Postgres/Neon URL only when the books outgrow one file; `backup_shop` follows
# the engine and switches to pg_dump by itself.
DATABASE_URL=
# Where the SQLite file lives; leaving this blank keeps it in the backend folder.
# Put it OUTSIDE any synced folder - a OneDrive or Dropbox copy taken while the
# server is writing gives a database that will not open. `manage.py check` warns
# (config.W001) when it spots one.
DATABASE_PATH=

# Optional product photo storage. Leave blank for local development; set the
# Cloudinary API environment URL in the hosting provider's secret settings.
CLOUDINARY_URL=

# CORS (comma-separated list of frontend origins allowed to call this API)
# On a hosted shop leave this EMPTY: the built app is served from this same
# server, so it needs no permission, and a dev-machine origin left here is what
# `manage.py check --deploy` reports as config.W013.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Required in production behind HTTPS, e.g. https://pos.example.com
CSRF_TRUSTED_ORIGINS=

# Twilio WhatsApp (leave blank to disable restock notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
OWNER_WHATSAPP_NUMBER=

# Safaricom Daraja STK Push (leave blank to disable M-Pesa STK)
# Run `python manage.py check_mpesa` before the first real payment: it reports
# these by name with a character count only (never a value), asks Daraja for a
# token for real, and proves the callback URL is public HTTPS and on the path
# this app actually serves. Add `--test-stk 07XXXXXXXX` to send yourself a KES 1
# prompt that is not saved in the books.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a public HTTPS URL that Safaricom can reach. A localhost or
# 192.168.x.x address means the money leaves the customer and nothing marks the
# bill paid. On a trading server (DEBUG=False) `manage.py check` makes that an
# error - config.E012/E013/E014 - so deploy/duka-pos.service refuses to boot;
# while building on a laptop the same sentences are warnings (W017/W018/W019) and
# the server still starts, because a tunnel address changes daily.
MPESA_CALLBACK_URL=https://your-public-domain.example/api/mpesa/callback/
# Long random value; also written into the callback URL as ?token=. It is the
# only thing stopping a stranger from marking any bill paid.
MPESA_CALLBACK_TOKEN=generate-a-long-random-value
MPESA_REQUEST_TIMEOUT_SECONDS=15
# How long a prompt waits before the till may send another. Only a prompt
# Safaricom never accepted (no checkout request id) expires on this clock - one
# Daraja is holding stays open until it answers, `check-payment` asks, or the
# scheduled `reconcile_mpesa` runs, because a PIN typed at minute nine is real
# money and marking that unpaid loses it.
MPESA_STK_PENDING_TIMEOUT_MINUTES=5
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=GreenLight
MPESA_TRANSACTION_DESCRIPTION=POS payment

# HTTPS-only toggles. Leave these off while the shop opens the till as
# http://192.168.x.x or http://computer-name:8000 - a Secure cookie is never sent
# over plain http and an SSL redirect has nowhere to go, so the admin would be
# locked out of its own server. Set all four to their secure values on the day
# the shop is given a domain with a certificate.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
